# Copy this file to .env and fill in your API key:
#   cp .env.example .env

# Required
OPENAI_API_KEY=sk-proj
# Optional -- all have working defaults if omitted
MODEL_NAME=gpt-4o
TEMPERATURE=0.0
# Base URL override for the OpenAI-compatible API (some setups call this
# OPENAI_API_BASE -- this project reads API_BASE_URL specifically).
API_BASE_URL=https://api.openai.com/v1
PORT=7860
LOG_LEVEL=INFO
